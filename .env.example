# --- Core (required) ---
DATABASE_URL=postgresql://postgres@localhost:5432/zitsy_store

AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Canonical public origin. Production MUST be the official domain exactly:
#   NEXT_PUBLIC_APP_URL=https://zitsy.darkhub.dev
# Never point this at a Vercel preview URL (*.vercel.app) or a localhost host
# in production: it feeds canonicals, OG URLs, JSON-LD, sitemap, robots and
# tracking links. Local development uses http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Zitsy
NEXT_PUBLIC_SITE_TAGLINE=Easy as Zitsy

STORE_CURRENCY=GBP

# --- Printify (server-only; catalog sync + fulfillment) ---
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_WEBHOOK_SECRET=
PRINTIFY_USER_AGENT=Zitsy/1.0 (support@zitsy.example)
PRINTIFY_AUTO_SEND_TO_PRODUCTION=false

# --- PayPal (only active payment provider) ---
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Resend (transactional email only) ---
RESEND_API_KEY=
EMAIL_FROM=Zitsy <orders@zitsy.example>

# --- Commerce pricing / shipping ---
# Currency Printify returns fulfillment cost + shipping in (usually USD).
PRINTIFY_COST_CURRENCY=USD
# Explicit FX rates used to normalize Printify amounts into STORE_CURRENCY.
# Format: FROM:TO=RATE,FROM:TO=RATE. Required when currencies differ (never 1:1).
STORE_FX_RATES=USD:GBP=0.754
# Markup (percent) applied over the FX-converted fulfillment cost when pricing
# variants. This is a markup (price = cost x (1 + pct/100)), NOT a gross margin.
STORE_MARKUP_PERCENT=40
# Payment-processing allowance used by the order-level profitability guard.
# This is a conservative assumption, not a contractual PayPal fee.
# fee = ceil(orderRevenue * PAYMENT_FEE_PERCENT / 100) + PAYMENT_FEE_FIXED_MINOR
PAYMENT_FEE_PERCENT=3.4
PAYMENT_FEE_FIXED_MINOR=20
# Minimum acceptable expected contribution per order, in store minor units.
# Must be positive so a zero-profit order is always rejected.
STORE_MIN_CONTRIBUTION_MINOR=1
# Fixed merchant-side cost allowance per order, in store minor units. Keep 0
# unless a known per-order overhead exists. Not a tax/VAT engine.
STORE_MERCHANT_COST_MINOR=0

# --- Scheduled catalog reconciliation (Vercel Cron) ---
CRON_SECRET=
