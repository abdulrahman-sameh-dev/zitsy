# Runtime: Node >=22.13 <23 (see .nvmrc) and pnpm 11.5.2.

# --- Core (required) ---
DATABASE_URL=postgresql://postgres@localhost:5432/zitsy_store

# Required: at least 32 random characters. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Canonical public origin. Production MUST be the official domain exactly:
#   NEXT_PUBLIC_APP_URL=https://zitsy.darkhub.dev
# Never point this at a Vercel preview URL (*.vercel.app) or a localhost host
# in production: it feeds canonicals, OG URLs, JSON-LD, sitemap, robots and
# tracking links. Local development uses http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Zitsy
NEXT_PUBLIC_SITE_TAGLINE=Easy as Zitsy

STORE_CURRENCY=GBP

# --- Printify (server-only; catalog sync + fulfillment) ---
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
PRINTIFY_WEBHOOK_SECRET=
PRINTIFY_USER_AGENT=Zitsy/1.0 (support@zitsy.example)
PRINTIFY_AUTO_SEND_TO_PRODUCTION=false

# --- PayPal (only active payment provider) ---
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Resend (transactional email only) ---
RESEND_API_KEY=
EMAIL_FROM=Zitsy <orders@zitsy.example>
# Store inbox for contact-form messages and internal new-order notices.
# Deliberately separate from EMAIL_FROM, which is only the sender identity.
SUPPORT_EMAIL=

# --- Commerce pricing / shipping ---
# Currency Printify returns fulfillment cost + shipping in (usually USD).
PRINTIFY_COST_CURRENCY=USD
# Explicit FX rates used to normalize Printify amounts into STORE_CURRENCY.
# Format: FROM:TO=RATE,FROM:TO=RATE. Required when currencies differ (never 1:1).
STORE_FX_RATES=USD:GBP=0.754
# Markup (percent) applied over the FX-converted fulfillment cost when pricing
# variants. This is a markup (price = cost x (1 + pct/100)), NOT a gross margin.
STORE_MARKUP_PERCENT=40
# Payment-processing allowance used by the order-level profitability guard.
# This is a conservative assumption, not a contractual PayPal fee.
# fee = ceil(orderRevenue * PAYMENT_FEE_PERCENT / 100) + PAYMENT_FEE_FIXED_MINOR
PAYMENT_FEE_PERCENT=3.4
PAYMENT_FEE_FIXED_MINOR=20
# Minimum acceptable expected contribution per order, in store minor units.
# Must be positive so a zero-profit order is always rejected.
STORE_MIN_CONTRIBUTION_MINOR=1
# Fixed merchant-side cost allowance per order, in store minor units. Keep 0
# unless a known per-order overhead exists. Not a tax/VAT engine.
STORE_MERCHANT_COST_MINOR=0

# --- Scheduled catalog reconciliation (Vercel Cron) ---
CRON_SECRET=

# --- Analytics (optional; browser-visible provider IDs) ---
# Analytics only loads after explicit visitor consent. Leave both empty to
# disable behavioural analytics entirely. GA4 page URLs are sanitised in code;
# Clarity URL masking is an external dashboard setting and must be verified
# before enabling Clarity.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# --- Analytics reporting (optional; server-only, /admin/analytics) ---
# Read-only credentials for the unified dashboard. Never expose these with a
# NEXT_PUBLIC_ prefix. Leave a provider empty to show "not configured".
# Vercel Web Analytics: create a token with access to the project.
VERCEL_ANALYTICS_TOKEN=
VERCEL_ANALYTICS_PROJECT_ID=
# Optional for personal accounts; required when the project belongs to a team.
VERCEL_ANALYTICS_TEAM_ID=
# GA4 Data API: numeric property ID (no "properties/" prefix) plus a service
# account with analytics.readonly. Paste the private key with literal \n
# newlines escaped, as shown by Google Cloud.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=
# Clarity Data Export API token. The public project ID above is also required.
# Clarity only supports 3-day windows and 10 requests per project per day.
CLARITY_API_TOKEN=

# --- Admin dashboard (optional; server-only) ---
# Both values must be set to enable /admin. Use a long, unique password.
# Admin sessions are signed with AUTH_SECRET and the current credentials, and
# expire after 12 hours. Changing either credential invalidates active sessions.
ADMIN_USERNAME=
ADMIN_PASSWORD=
