# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/e2e/.resend-capture.json
/playwright-report/
/test-results/

# next.js
/.next/
/out/

/zitsy-marketing

# Local-only catalog/debug utilities. The two scripts that ship with the repo
# are explicitly un-ignored so they remain trackable on a fresh checkout.
/scripts/*
!/scripts/printify-sync.ts
!/scripts/generate-brand-assets.py

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated prisma client
/src/generated/
